---
/** Ikony Lucide (lucide-static) wstawiane jako inline SVG + ikony marek */
interface Props {
    name: string;
    class?: string;
}

const { name, class: className = '' } = Astro.props;

const lucide = import.meta.glob<string>(
    '/node_modules/lucide-static/icons/{house,waves,paw-print,square-parking,cherry,film,flame,sprout,trees,snowflake,phone,mail,map-pin,navigation,chevron-left,chevron-right,x,menu,calendar,arrow-left}.svg',
    { query: '?raw', import: 'default', eager: true },
);

const brands: Record<string, string> = {
    instagram:
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.25"/><circle cx="17.6" cy="6.4" r="0.6" fill="currentColor"/></svg>',
    facebook:
        '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21.5v-7.6h2.6l.4-3h-3V9c0-.9.3-1.5 1.5-1.5h1.6V4.8c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V11H7.8v3h2.6v7.5h3.1Z"/></svg>',
};

let raw = brands[name] ?? lucide[`/node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Brak ikony: ${name}`);

const svg = raw
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/<svg[^>]*?>/, (tag) => tag.replace(/\s(class|width|height)="[^"]*"/g, ''))
    .replace('<svg', `<svg class="icon ${className}" aria-hidden="true" focusable="false"`)
    .trim();
---

<Fragment set:html={svg} />
